# Copy this file to ".env" for local development. NEVER commit the real ".env".
# On Render, set these in the dashboard under Environment instead.

# Long random string used to sign sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Gmail account + a Google "App password" (Google Account -> Security -> App passwords).
# Used to send OTP codes and approval/rejection notifications.
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-character-app-password

# Required to create the (single) administrator account at /admin-register.
# If empty, /admin-register is disabled.
ADMIN_SETUP_CODE=choose-a-long-secret-code

# Set to false to let people register without an emailed OTP code.
# Use this if email sending is unavailable (Render's free plan blocks SMTP). Default: true.
# REQUIRE_EMAIL_OTP=false

# Local development only: print OTP codes in the terminal instead of emailing them
# (only used when EMAIL_USER / EMAIL_PASS are not set).
# DEV_PRINT_OTP=1

# Optional: where database.db and uploads/ live. Point at a persistent disk on Render.
# DATA_DIR=/var/data
